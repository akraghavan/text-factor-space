{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(make:*)",
      "Bash(python:*)"
    ],
    "deny": [
      "Read(./data/raw/tnic3*)",
      "Read(./data/interim/tenk_linked*)",
      "Read(./data/processed/crsp*)",
      "Read(./data/raw/ccm*)",
      "Read(./data/raw/crsp*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.ssh/**)",
      "Bash(git add data:*)",
      "Bash(git add ./data:*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}
